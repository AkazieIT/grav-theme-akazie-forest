{# `col-md-12` is not redundant here: css/main.scss keys
   `.container-inner:has(.col-md-12) { padding: 0 }` off this class, and #item is
   the only .col-md-12 on blog/portfolio pages. Removing it re-introduces the
   container padding on every listing and item page. #}
<div class="columns">
    <div id="item" class="column col-12 col-md-12 extra-spacing">
        {% block item %}{% endblock %}
    </div>
</div>
